<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tarjetas.App.ViewModels"
             xmlns:modelos="clr-namespace:Tarjetas.App.Modelos"
             xmlns:comp="clr-namespace:Tarjetas.App.Comportamientos"
             x:Class="Tarjetas.App.Paginas.MazosPage"
             x:DataType="vm:MazosViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,16,20,0" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Mazos" FontSize="30" FontAttributes="Bold" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button Text="🏆 Recompensas" Style="{StaticResource Chip}" Command="{Binding AbrirRecompensasCommand}" />
                    <Button Text="⬇ Importar" Style="{StaticResource Chip}" Command="{Binding AbrirImportarCommand}" />
                </HorizontalStackLayout>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <Entry Placeholder="Buscar mazos" Text="{Binding Busqueda}" ClearButtonVisibility="WhileEditing" />
            </Border>

            <Label Grid.Row="2" Text="Modo edición: tocá un mazo para editar sus tarjetas"
                   IsVisible="{Binding ModoEdicion}" FontSize="13" Opacity="0.7" />

            <CollectionView x:Name="Lista" Grid.Row="3" ItemsSource="{Binding Mazos}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <Label Text="Tocá + para crear tu primer mazo, o ⬇ Importar para traer uno."
                           TextColor="{StaticResource Gris}" HorizontalTextAlignment="Center" Margin="0,48" />
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="140" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:MazoItem">
                        <Border BackgroundColor="{Binding Fondo}" Stroke="{Binding Borde}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" Padding="16" MinimumHeightRequest="110">
                            <Border.Behaviors>
                                <comp:TemblorBehavior Activo="{Binding EnEdicion}" />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MazosViewModel}}, Path=TocarMazoCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="✎" FontSize="18" Opacity="0.6" VerticalOptions="Start">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MazosViewModel}}, Path=EditarMazoCommand}"
                                                CommandParameter="{Binding Id}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                <Label Text="{Binding Resumen}" FontSize="13" Opacity="0.7" />
                                <Border IsVisible="{Binding TienePendientes}" BackgroundColor="{Binding FondoEtiqueta}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding Pendientes}" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,24" Spacing="12">
            <Button Text="{Binding TextoBotonEdicion}" Style="{StaticResource FabSecundario}"
                    Command="{Binding AlternarEdicionCommand}">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="8" Offset="0,3" />
                </Button.Shadow>
            </Button>
            <Button Text="+" Style="{StaticResource Fab}" Command="{Binding NuevoMazoCommand}">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.28" Radius="10" Offset="0,4" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
